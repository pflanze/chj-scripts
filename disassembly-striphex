}

use Getopt::Long;
our $verbose=0;
#our $opt_dry;
our $opt_gambit;
GetOptions("verbose"=> \$verbose,
	   "help"=> sub{usage},
	   "gambit"=> \$opt_gambit,
	   #"dry-run"=> \$opt_dry,
	   ) or exit 1;
#usage unless @ARGV;

our $hexdigit= qr/0-9a-f/;
our $hexnumber= qr/[$hexdigit]+/;

sub substitute {
    #"X" x length($_[0])
    "XXXXXXX"
}

while (<>) {
    if ($opt_gambit) {
	s/\b(___\w+_2e_o)(\d+)\b/$1."YY"/ge;
    }
    s/\b0x$hexnumber\b/0xXXXXXX/sg;
    s/\.$hexnumber([.+>])/.XXXXXX$1/sg;
    print;
}


