sub _de_sym($s) {
    if (my ($hex) = $s =~ /^u(.*)/) {
        # XX ?
        chr(hex($1))
    } else {
        # src/legacy.rs
        +{
            "SP" => "@",
                "BP" => "*",
                "RF" => "&",
                "LT" => "<",
                "GT" => ">",
                "LP" => "(",
                "RP" => ")",
                "C" => ",",
        }->{$s} or die '_de_sym: invalid "$..$" symbol: "'.$s.'"'
    }
}

sub rust_expand_sym($s) {
    my $out = "";
    my $rest = $s;
    while (length($rest)) {
        $rest =~ s/^_\$/\$/; # wow such a hack, I mean in the original format already
        if (my ($sym, $rest2) = $rest=~ m{^\$(\w+)\$(.*)}s) {
            $out .= _de_sym($sym);
            #warn "out = '$out' after dollar sym '$sym'";
            $rest = $rest2;
        } elsif (my ($word, $rest3) = $rest=~ m{^([\w.]+)(.*)}s) {
            $out .= $word;
            $rest = $rest3;
        } else {
            die "rust_expand_sym: unknown rest '$rest' in '$s'"
        }
    }
    $out
}

sub rust_demangle($s) {
    my $out = "";
    my $rest = $s;
    while (length($rest)) {
        #warn "rest = '$rest'";
        if (my ($rest4) = $rest =~ m/^E(.*)/) {
            # Remove surplus namespace separator, hack on my part?
            $out =~ s/::$//;
            # There may be "garbage" after the symbol, append it back, OK?
            $out .= $rest4;
            last
        }
        if (my ($len, $rest3) = $rest=~ m{^(\d+)(.*)}s) {
            my $sym_raw = substr $rest3, 0, $len;
            my $sym = rust_expand_sym($sym_raw);
            $sym =~ s/\.\./::/sg; # wow such an other hack in orig format?
            $rest = substr $rest3, $len;
            $out .= $sym . "::";
            #warn "out = '$out' after sym '$sym'";
        } else {
            die "rust_demangle: unknown rest '$rest' in '$s'"
        }
    }
    $out
}

