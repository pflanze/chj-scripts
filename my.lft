#!/bin/bash
set -meuo pipefail
IFS=

tail=20

usage() {
    echo "Usage: $0 [dir [lst-options]]"
    echo "   show the last $tail items of the mtime-sorted tree of all"
    echo "   non-dir items in . or the given dir"
    exit 1
}

if [ $# -ge 1 ]; then
    if [ "$1" = "-h" -o "$1" = --help ]; then
        usage
    fi
    dir=$1
    shift
else
    dir=.
fi

exec ltree "$dir" filter '!d' tail "$tail" "$@"
