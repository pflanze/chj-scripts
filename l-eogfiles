#!/bin/bash
set -euo pipefail
IFS=

usage() {
    echo "Usage: $0 [dir]"
    echo "  Runs eogfiles on the files directly (l-eogfiles) or deeply (lf-eogfiles) in dir or .,"
    echo "  sorted incrementally by mtime."
    exit 1
}

if [ $# -eq 1 ]; then
    if [ "$1" = -h ] || [ "$1" = --help ]; then
        usage
    fi
    dir="$1"
elif [ $# -eq 0 ]; then
    dir=.
else
    usage
fi

bn="$(basename "$0")"

case "$bn" in
    l-eogfiles)
        mode=ls
        ;;
    lf-eogfiles)
        mode=find
        ;;
    *)
        echo "$0: unknown program name '$bn'" >&2
        exit 3
        ;;
esac

lst --fullpath --$mode "$dir" -rt --zo \
    | eogfiles --stdin --z --fullscreen --disable-gallery --new-instance

