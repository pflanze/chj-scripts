#!/usr/bin/env perl

my $copyright= <<'COPYRIGHT';
# Copyright 2026 by Christian Jaeger <ch@christianjaeger.ch>
# Published under the same terms as perl itself
COPYRIGHT

use strict;
use utf8;
use warnings;
use warnings FATAL => 'uninitialized';
use experimental 'signatures';

my ($email_full)= $copyright=~ / by ([^\n]*)/s;

my ($mydir, $myname);
BEGIN {
    $0=~ /(.*?)([^\/]+)\z/s or die "?";
    ($mydir, $myname)=($1,$2);
}

use Getopt::Long;
#use Chj::xperlfunc;
#use Chj::ruse;
#use Chj::Backtrace; 
#use FP::Show; use FP::Repl; use FP::Repl::Trap; #

sub usage {
    print STDERR map{"$_\n"} @_ if @_;
    print "$myname

  Verify the git status is clean, if so, delete all files that are
  tracked in git, as well as the dirs they are in if empty. Does not
  commit.

  ($email_full)
";
exit (@_ ? 1 : 0);
}

our $verbose=0;
#our $opt_dry;
GetOptions("verbose"=> \$verbose,
	   "help"=> sub{usage},
	   #"dry-run"=> \$opt_dry,
	   ) or exit 1;
usage if @ARGV;


my $is_clean = system("git status | grep -q 'nothing to commit, working tree clean'") == 0;

if (!$is_clean) {
    die "$myname: dir is not clean\n"
}

open my $in, "-|", qw(git ls-files -z) or die "git: $? $!";

my %dirs;

local $/ = "\0";
while (<$in>) {
    chomp;
    unlink $_;
    if (s{/[^/]+\z}{}) {
        # dir
        $dirs{$_}=1;
    }
}

for (reverse sort keys %dirs) {
    print "rmdir '$_'\n";
    rmdir $_;
}

